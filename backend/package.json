    "@hono/zod-validator": "^0.4.2",
    "dotenv": "^16.4.7",
    "hono": "^4.6.13",
    "mssql": "^11.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
