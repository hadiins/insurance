# Copy to .env and fill in real values. Never commit the real .env — see README.md.

SA_PASSWORD=
# Least-privilege login the app connects as (see README "first run only" setup) — never sa.
DB_USER=aqsat_app
DB_PASSWORD=
JWT_KEY=
# Legacy only — see README. National IDs are stored as plaintext by owner decision (2026-08-28);
# this key is needed only to decrypt pre-2026-08-28 NationalIdEncrypted columns during the
# one-time startup backfill, and can be left blank on any database created after that date.
NATIONAL_ID_KEY=
BOOTSTRAP_SECRET=

API_IR_KEY=
API_IR_ALLOW_PAID=false

BACKUP_RETENTION_DAYS=14

# Offsite leg — Google Drive, ciphertext-only. ALL opt-in: leave unset and the daily job just
# writes local .baks like before. To enable:
#   1. openssl rand -base64 32            -> BACKUP_ENCRYPTION_KEY (store OFF the server;
#      without it no offsite .enc can ever be decrypted — see docs/RESTORE-RUNBOOK.md step 1b)
#   2. Google Cloud console: service account + Drive API enabled -> download its JSON key
#   3. Create a Drive folder, share it with the service-account email (Editor)
#   -> BACKUP_OFFSITE_FOLDER_ID = the folder's ID (the part after /folders/ in its URL)
#   -> BACKUP_OFFSITE_SERVICE_ACCOUNT_JSON = the JSON key, EITHER inline (past the whole JSON
#      as one quoted string) OR a host file path mounted read-only into the api container
#      (e.g. ./secrets/gdrive-key.json:/run/secrets/gdrive-key.json:ro, then set this to
#      /run/secrets/gdrive-key.json — preferred, keeps the key out of `docker inspect`).
BACKUP_ENCRYPTION_KEY=
BACKUP_OFFSITE_FOLDER_ID=
BACKUP_OFFSITE_SERVICE_ACCOUNT_JSON=

# docs/TASKS.md Task 21/22 (Aqsat.Updater + the update panel) — deferred by default (see
# docs/UPDATE-SYSTEM.md); only needed once both are actually deployed.
UPDATER_SHARED_TOKEN=
UPDATER_SIGNING_PUBLIC_KEY_PEM=
# Release version (e.g. 1.0.0) stamped into the api image at BUILD time — `docker compose build`
# forwards it, and `scripts/release/publish-local.sh --version x.y.z` sets it explicitly. The
# update panel reads the version from the image itself, so this only matters when BUILDING, never
# at runtime. Unstamped images report "unknown" and refuse version-gated update packages.
APP_VERSION=
