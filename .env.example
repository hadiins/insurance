# Copy to .env and fill in real values. Never commit the real .env — see README.md.

SA_PASSWORD=
# Least-privilege login the app connects as (see README "first run only" setup) — never sa.
DB_USER=aqsat_app
DB_PASSWORD=
JWT_KEY=
NATIONAL_ID_KEY=
BOOTSTRAP_SECRET=

API_IR_KEY=
API_IR_ALLOW_PAID=false

BACKUP_RETENTION_DAYS=14

# docs/TASKS.md Task 21/22 (Aqsat.Updater + the update panel) — deferred by default (see
# docs/UPDATE-SYSTEM.md); only needed once both are actually deployed.
UPDATER_SHARED_TOKEN=
UPDATER_SIGNING_PUBLIC_KEY_PEM=
# Release version (e.g. 1.0.0) stamped into the api image at BUILD time — `docker compose build`
# forwards it, and `scripts/release/publish-local.sh --version x.y.z` sets it explicitly. The
# update panel reads the version from the image itself, so this only matters when BUILDING, never
# at runtime. Unstamped images report "unknown" and refuse version-gated update packages.
APP_VERSION=
